# ── LLM (OpenRouter) ──────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys  (starts with sk-or-v1-)
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Free & capable models on OpenRouter (pick one):
#   google/gemma-2-9b-it:free
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
# Paid but most reliable for multi-step agents:
#   openai/gpt-4o-mini
OPENAI_MODEL_NAME=google/gemma-2-9b-it:free

# Used automatically when the primary model hits a rate/daily-token limit (429).
# Provider quotas are per-model, so a smaller model usually still has budget.
# On Groq use: llama-3.1-8b-instant
OPENAI_FALLBACK_MODEL_NAME=openai/gpt-oss-20b

# Per-request timeout for LLM calls (seconds). Prevents a hung/blackholed
# connection from stalling a run for the client library's default (10 min) —
# failing fast lets the retry/fallback logic kick in instead.
OPENAI_TIMEOUT_SECONDS=25

# Number of self-critique rounds (0-2) to run during SCHEDULED drafts.
# Each round roughly adds one more full-output LLM call per agent.
# Interactive runs control this per-request via the Self-review rounds
# selector in the UI.
SCHEDULED_SELF_CRITIQUE_ROUNDS=0


# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# NOTE: Use a Google App Password — NOT your Gmail login password.
# Get one at: https://myaccount.google.com/apppasswords (16 chars, no spaces)
# ⚠️  REMINDER: Set these before using the approval workflow or scheduler.
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=dummy-google-app-password
NOTIFY_EMAIL=your-gmail@gmail.com


# ── App URL ────────────────────────────────────────────────────────────────────
# Used for review links in emails.  Change to your ngrok/server URL in production.
APP_BASE_URL=http://localhost:8000


# ── Auth (REQUIRED — the app refuses to start if HERMES_API_KEY is unset) ──────
# Tier A: real accounts (sign up / log in at /signup, /login) — email +
# password, stored hashed in data/blogagent.db (SQLite, created automatically
# on first run). No env var needed for this tier.
# Tier C: Hermes Agent / curl access to /api/jobs/*, /api/posts* — sent as the
# X-API-Key header. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_API_KEY=change-me-to-a-random-string
# (Tier B — review-email magic links — needs no env var: each post gets its
# own random token generated in src/pending.py at creation time.)


# ── LinkedIn ───────────────────────────────────────────────────────────────────
# ⚠️  REMINDER: Set these before using the publish workflow.
# Tokens expire every ~60 days — a 401 means you need to re-run OAuth.
# Setup:
#   1. Create a LinkedIn Developer app at https://developer.linkedin.com
#   2. Add products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
#   3. OAuth scope: openid profile w_member_social
#   4. Get LINKEDIN_PERSON_URN from: GET https://api.linkedin.com/v2/userinfo  (field: sub)
LINKEDIN_ACCESS_TOKEN=dummy-linkedin-token
LINKEDIN_PERSON_URN=urn:li:person:dummy


# ── Medium ─────────────────────────────────────────────────────────────────────
# Medium's API is CLOSED to new integrations since 1 Jan 2025.
# No new tokens are issued. Leave empty unless you have a pre-2025 legacy token.
# Medium publishing is a manual paste flow — the 9:00 AM email includes the markdown.
MEDIUM_TOKEN=


# ── Scheduler ─────────────────────────────────────────────────────────────────
# true  = APScheduler runs draft @ 8:30 IST and publish @ 9:00 IST internally.
# false = Flip this once Hermes Agent is handling scheduling (Phase 4),
#         to prevent double-firing.
ENABLE_INTERNAL_SCHEDULER=true

# ── Scheduler resilience ──────────────────────────────────────────────────────
# How late a missed job may still run (seconds). Without this, a redeploy or a
# sleeping host spanning 8:30 IST silently skips that day's draft entirely.
SCHEDULER_MISFIRE_GRACE_SECONDS=3600

# Extra crew attempts before giving up on the day, and the wait between them.
# The LLM layer already retries and switches models, so a failure reaching here
# is usually a quota window — worth waiting minutes, not seconds.
DRAFT_ATTEMPTS=2
DRAFT_RETRY_DELAY_SECONDS=180

# A topic stays in the queue until a draft actually exists. These bound that:
# a claim older than this is assumed dead (process killed mid-run) and may be
# retaken; a topic failing this many times is set aside so the queue can drain.
TOPIC_STALE_CLAIM_SECONDS=1800
MAX_TOPIC_ATTEMPTS=3

# ── Run records ───────────────────────────────────────────────────────────────
# How many run records to keep in data/runs.jsonl before trimming oldest.
RUN_LOG_MAX=500

# Minimum fraction of the writer's draft the editor must leave standing. Below
# this the polish is rejected and the writer's version is kept. Observed before
# this guard existed: one run went 1027 words -> 177 and was queued for approval.
EDITOR_MIN_LENGTH_RATIO=0.75

# ── Cost accounting ───────────────────────────────────────────────────────────
# Token counts are always measured from the provider response. Dollar cost is
# ONLY computed if you set both of these to your model's actual rates, in USD
# per MILLION tokens. Left unset, cost is reported as null rather than guessed —
# OpenRouter prices differ per model and change, so there is no safe default.
# Look yours up at https://openrouter.ai/models
# MODEL_PRICE_PER_MTOK_IN=0.10
# MODEL_PRICE_PER_MTOK_OUT=0.50

# ── State storage ─────────────────────────────────────────────────────────────
# Where mutable state is written. Defaults to ./data and ./output next to the
# code, which is correct locally and under docker-compose.
#
# On a platform that rebuilds the code directory each deploy (Railway, Render,
# Fly, Heroku), leaving DATA_DIR unset means pending posts, the topic queue and
# run records are on EPHEMERAL storage and are lost on the next deploy. The app
# prints a warning at startup when it detects this.
#
# On Railway: attach a volume, then set
#   DATA_DIR=${{RAILWAY_VOLUME_MOUNT_PATH}}
# DATA_DIR=/data
# OUTPUT_DIR=/data/output
